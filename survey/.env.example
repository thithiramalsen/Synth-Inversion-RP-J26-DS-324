# Documentation only: set these in the hosting environment; no automatic dotenv loading.
SURVEY_REMOTE_MODE=1
SURVEY_C1_OPEN=0
SURVEY_C1_BUNDLE=/persistent/study/bundle.json
SURVEY_C1_CONFIG=/app/survey/config/c1_pilot_v1.json
SURVEY_DATABASE_PATH=/persistent/responses/c1-pilot.db
# Set for Render/Neon. Stored only in host secret settings, never in Git.
# When present, responses/accounts/invitations use PostgreSQL instead of SQLite.
SURVEY_DATABASE_URL=
# Optional local workaround when IPv6 times out but IPv4 works. Default: 0.
# Preserves hostname/TLS; resolves IPv4 addresses each time. Not needed on every host.
SURVEY_POSTGRES_IPV4=0
# Generate a random secret of at least 32 characters; never put it in frontend env vars.
SURVEY_ADMIN_TOKEN=
# Initial researcher login (local run_rehearsal generates these automatically).
# Hash format is produced by survey/backend/security.py password_hash(); never use plaintext here.
SURVEY_RESEARCHER_USERNAME=
SURVEY_RESEARCHER_PASSWORD_HASH=
# Empty for same-origin frontend/API; otherwise list only the actual HTTPS frontend origin.
SURVEY_ALLOWED_ORIGINS=
