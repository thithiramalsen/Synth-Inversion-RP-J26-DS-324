# Documentation only: set these in the hosting environment; no automatic dotenv loading.
SURVEY_REMOTE_MODE=1
SURVEY_C1_OPEN=0
SURVEY_C1_BUNDLE=/persistent/study/bundle.json
SURVEY_C1_CONFIG=/app/survey/config/c1_pilot_v1.json
SURVEY_DATABASE_PATH=/persistent/responses/c1-pilot.db
# Generate a random secret of at least 32 characters; never put it in frontend env vars.
SURVEY_ADMIN_TOKEN=
# Empty for same-origin frontend/API; otherwise list only the actual HTTPS frontend origin.
SURVEY_ALLOWED_ORIGINS=
